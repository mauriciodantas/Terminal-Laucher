<?xml version="1.0" encoding="utf-8"?>
<!-- Nostromo terminal home: status header, clock, date and the motion tracker panel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <TextView
        android:id="@+id/nostromo_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ibm_plex_mono_medium"
        android:includeFontPadding="false"
        android:letterSpacing="0.12"
        android:maxLines="1"
        android:text="@string/nostromo_header"
        android:textColor="#FF7DFFB2"
        android:textSize="10sp" />

    <TextClock
        android:id="@+id/nostromo_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/vt323_regular"
        android:format12Hour="HH:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:shadowColor="#667DFFB2"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="8"
        android:textColor="#FF7DFFB2"
        android:textSize="44sp"
        tools:text="03:47" />

    <TextClock
        android:id="@+id/nostromo_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ibm_plex_mono_medium"
        android:format12Hour="EEEE · dd.MMM.yyyy"
        android:format24Hour="EEEE · dd.MMM.yyyy"
        android:includeFontPadding="false"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textColor="#FF7DFFB2"
        android:textSize="12sp"
        tools:text="SÁBADO · 02.OUT.2026" />

    <TextView
        android:id="@+id/nostromo_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/ibm_plex_mono_regular"
        android:includeFontPadding="false"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:text="@string/nostromo_status_line"
        android:textColor="#FF50A172"
        android:textSize="10sp" />

    <LinearLayout
        android:id="@+id/nostromo_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/nostromo_panel_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/nostromo_panel_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/ibm_plex_mono_semibold"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:text="@string/nostromo_panel_title"
                android:textColor="#FF07090A"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/nostromo_panel_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ibm_plex_mono_semibold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/nostromo_panel_state"
                android:textColor="#FF07090A"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nostromo_target_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="6dp"
            android:paddingEnd="4dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/nostromo_target_lead"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vt323_regular"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="#667DFFB2"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8"
                android:textColor="#FF7DFFB2"
                android:textSize="40sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/nostromo_target_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nostromo_target_primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/ibm_plex_mono_semibold"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.05"
                    android:maxLines="1"
                    android:textColor="#FFE8FBEE"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/nostromo_target_secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/ibm_plex_mono_regular"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.06"
                    android:maxLines="1"
                    android:textColor="#FF6FCF98"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nostromo_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/nostromo_shortcuts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal" />
    </LinearLayout>

    <TextView
        android:id="@+id/nostromo_quick_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/ibm_plex_mono_regular"
        android:includeFontPadding="false"
        android:letterSpacing="0.1"
        android:maxLines="1"
        android:text="@string/nostromo_quick_access"
        android:textColor="#FF50A172"
        android:textSize="10sp" />
    <LinearLayout
        android:id="@+id/nostromo_chats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:visibility="gone" />
</LinearLayout>
