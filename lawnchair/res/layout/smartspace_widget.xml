<?xml version="1.0" encoding="utf-8"?>
<!-- Nostromo terminal home: status header, clock, date and the motion tracker panel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <include layout="@layout/smartspace_widget_readout" />

    <include
        layout="@layout/smartspace_widget_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/nostromo_quick_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/ibm_plex_mono_regular"
        android:includeFontPadding="false"
        android:letterSpacing="0.1"
        android:maxLines="1"
        android:text="@string/nostromo_quick_access"
        android:textColor="#FF50A172"
        android:textSize="10sp" />
</LinearLayout>
