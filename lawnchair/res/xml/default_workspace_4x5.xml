<favorites xmlns:launcher="http://schemas.android.com/apk/res-auto/com.android.launcher3">
    <!-- Hotseat: same dock apps as the Samsung One UI Home (WhatsApp, Phone, Spotify, Chrome) -->
    <resolve
        launcher:container="-101"
        launcher:screen="0"
        launcher:x="0"
        launcher:y="0" >
        <favorite launcher:packageName="com.whatsapp" launcher:className="com.whatsapp.Main" />
    </resolve>

    <resolve
        launcher:container="-101"
        launcher:screen="1"
        launcher:x="1"
        launcher:y="0" >
        <favorite launcher:packageName="com.samsung.android.dialer" launcher:className="com.samsung.android.dialer.DialtactsActivity" />
    </resolve>

    <resolve
        launcher:container="-101"
        launcher:screen="2"
        launcher:x="2"
        launcher:y="0" >
        <favorite launcher:packageName="com.spotify.music" launcher:className="com.spotify.music.MainActivity" />
    </resolve>

    <resolve
        launcher:container="-101"
        launcher:screen="3"
        launcher:x="3"
        launcher:y="0" >
        <favorite launcher:packageName="com.android.chrome" launcher:className="com.google.android.apps.chrome.Main" />
    </resolve>

    <!-- Screen 0: apps from the One UI Home grid, in a 4x4 block under the two-row terminal readout -->
    <resolve
        launcher:screen="0"
        launcher:x="0"
        launcher:y="2" >
        <favorite launcher:packageName="com.sec.android.app.camera" launcher:className="com.sec.android.app.camera.Camera" />
    </resolve>

    <resolve
        launcher:screen="0"
        launcher:x="1"
        launcher:y="2" >
        <favorite launcher:packageName="org.mozilla.focus" launcher:className="org.mozilla.focus.activity.MainActivity" />
    </resolve>

    <resolve
        launcher:screen="0"
        launcher:x="2"
        launcher:y="2" >
        <favorite launcher:packageName="com.google.android.youtube" launcher:className="com.google.android.youtube.app.honeycomb.Shell$HomeActivity" />
    </resolve>

    <resolve
        launcher:screen="0"
        launcher:x="3"
        launcher:y="2" >
        <favorite launcher:packageName="com.android.vending" launcher:className="com.android.vending.AssetBrowserActivity" />
    </resolve>

    <resolve
        launcher:screen="0"
        launcher:x="0"
        launcher:y="3" >
        <favorite launcher:packageName="com.google.android.apps.tachyon" launcher:className="com.google.android.apps.tachyon.MainActivity" />
    </resolve>

    <resolve
        launcher:screen="0"
        launcher:x="1"
        launcher:y="3" >
        <favorite launcher:packageName="com.google.android.gm" launcher:className="com.google.android.gm.ConversationListActivityGmail" />
    </resolve>

    <resolve
        launcher:screen="0"
        launcher:x="2"
        launcher:y="3" >
        <favorite launcher:packageName="com.google.android.apps.maps" launcher:className="com.google.android.maps.MapsActivity" />
    </resolve>

    <resolve
        launcher:screen="0"
        launcher:x="3"
        launcher:y="3" >
        <favorite launcher:packageName="com.google.android.apps.bard" launcher:className="com.google.android.apps.bard.shellapp.BardEntryPointActivity" />
    </resolve>

    <resolve
        launcher:screen="0"
        launcher:x="0"
        launcher:y="4" >
        <favorite launcher:packageName="com.google.android.apps.youtube.music" launcher:className="com.google.android.apps.youtube.music.activities.MusicActivity" />
    </resolve>

    <resolve
        launcher:screen="0"
        launcher:x="1"
        launcher:y="4" >
        <favorite launcher:packageName="com.google.android.apps.photos" launcher:className="com.google.android.apps.photos.home.HomeActivity" />
    </resolve>

    <resolve
        launcher:screen="0"
        launcher:x="2"
        launcher:y="4" >
        <favorite launcher:packageName="com.sec.android.app.popupcalculator" launcher:className="com.sec.android.app.popupcalculator.Calculator" />
    </resolve>

    <resolve
        launcher:screen="0"
        launcher:x="3"
        launcher:y="4" >
        <favorite launcher:packageName="com.sec.android.daemonapp" launcher:className="com.samsung.android.weather.app.AppLauncherActivity" />
    </resolve>

    <resolve
        launcher:screen="0"
        launcher:x="0"
        launcher:y="5" >
        <favorite launcher:packageName="com.sec.android.app.shealth" launcher:className="com.samsung.android.app.shealth.home.HomeMainActivity" />
    </resolve>

    <resolve
        launcher:screen="0"
        launcher:x="1"
        launcher:y="5" >
        <favorite launcher:packageName="com.onepassword.android" launcher:className="com.onepassword.android.app.StartActivity" />
    </resolve>

    <resolve
        launcher:screen="0"
        launcher:x="2"
        launcher:y="5" >
        <favorite launcher:packageName="com.fujifilm.instaxpal" launcher:className="com.fujifilm.instaxeye.ui.startup.SplashActivity" />
    </resolve>

    <resolve
        launcher:screen="0"
        launcher:x="3"
        launcher:y="5" >
        <favorite launcher:packageName="com.zhiliaoapp.musically" launcher:className="com.ss.android.ugc.aweme.splash.SplashActivity" />
    </resolve>
</favorites>
