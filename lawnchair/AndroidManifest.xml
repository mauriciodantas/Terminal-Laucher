<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="com.google.android.apps.nexuslauncher.permission.QSB" />
    <uses-permission android:name="com.kieronquinn.app.smartspacer.permission.ACCESS_SMARTSPACER"/>
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_HISTORY_BOOKMARKS" />
    <uses-permission android:name="android.permission.WRITE_HISTORY_BOOKMARKS" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS" tools:ignore="ProtectedPermissions"/>
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL" tools:ignore="ProtectedPermissions"/>
    <uses-permission android:name="android.permission.MANAGE_USERS" tools:ignore="ProtectedPermissions"/>
    <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES" tools:ignore="ProtectedPermissions"/>
    <uses-permission android:name="android.permission.STATUS_BAR_SERVICE" tools:ignore="ProtectedPermissions"/>
    <uses-permission android:name="android.permission.SUSPEND_APPS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Command bar: "agenda", {location}, brilho/rotação, silêncio and the scheduled commands. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Lets automation apps the user chooses run command bar lines (CommandRunActivity). -->
    <permission
        android:name="${applicationId}.permission.RUN_COMMAND"
        android:description="@string/cmd_run_permission_description"
        android:label="@string/cmd_run_permission_label"
        android:protectionLevel="dangerous" />

    <!-- Support non-cellular enabled devices -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!--override minSdk declared in it-->
    <uses-sdk tools:overrideLibrary="com.kieronquinn.app.smartspacer.sdk" />

    <permission
        android:name="${packageName}.permission.READ_SETTINGS"
        tools:node="remove" />
    <permission
        android:name="${packageName}.permission.WRITE_SETTINGS"
        tools:node="remove" />
    <permission
        android:name="${packageName}.permission.HOTSEAT_EDU"
        tools:node="remove" />

    <application>
        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />

        <activity
            android:name="app.lawnchair.ui.preferences.PreferenceActivity"
            android:autoRemoveFromRecents="true"
            android:exported="true"
            android:label="@string/settings_button_text"
            android:icon="@mipmap/ic_launcher_home"
            android:theme="@style/Theme.Lawnchair"
            android:windowSoftInputMode="adjustResize"
            android:enableOnBackInvokedCallback="true">
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="lawnchair" android:host="settings" android:pathPrefix="/" />
            </intent-filter>
        </activity>

        <activity
            android:label="@string/lawnchair_actions"
            android:icon="@mipmap/ic_launcher_home"
            android:name="app.lawnchair.gestures.ui.LawnchairShortcutActivity"
            android:exported="true"
            android:theme="@style/Theme.Lawnchair">
            <intent-filter>
                <action android:name="android.intent.action.CREATE_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name="app.lawnchair.gestures.ui.RunHandlerActivity"
            android:exported="true"
            android:theme="@style/Theme.Lawnchair">
            <intent-filter>
                <action android:name="app.lawnchair.START_ACTION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>


        <activity
            android:name="com.android.launcher3.secondarydisplay.SecondaryDisplayLauncher"
            tools:node="remove" />

        <activity
            android:name="app.lawnchair.ui.ApplyIconPackActivity"
            android:exported="true"
            android:theme="@style/Theme.Transparent">
            <intent-filter>
                <action android:name="app.lawnchair.APPLY_ICONS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name="app.lawnchair.ui.onboarding.OnboardingActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.onboarding"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Lawnchair" />

        <activity
            android:name="app.lawnchair.command.CommandActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="${applicationId}.command"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Lawnchair" />

        <!-- "Terminal" in the menu of selected text: the bar opens with it as {sel}. -->
        <activity-alias
            android:name="app.lawnchair.command.CommandSelection"
            android:exported="true"
            android:label="@string/cmd_selection_label"
            android:targetActivity="app.lawnchair.command.CommandActivity">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <!-- terminal://cmd?text=... (an NFC tag, a link) opens the bar with the command typed, not run. -->
        <activity-alias
            android:name="app.lawnchair.command.CommandLink"
            android:exported="true"
            android:targetActivity="app.lawnchair.command.CommandActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="terminal" android:host="cmd" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name="app.lawnchair.command.CommandRunActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:permission="${applicationId}.permission.RUN_COMMAND"
            android:theme="@style/Theme.Transparent">
            <intent-filter>
                <action android:name="${applicationId}.RUN_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name="app.lawnchair.command.CommandTileService"
            android:exported="true"
            android:icon="@drawable/ic_command_notification"
            android:label="@string/cmd_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name="app.lawnchair.command.CommandJobReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Remembers the tasks app picked the first time "t [task]" runs. -->
        <receiver
            android:name="app.lawnchair.command.TaskAppChosenReceiver"
            android:exported="false" />

        <activity
            android:name="app.lawnchair.command.ImportCommandsActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="Importar comandos"
            android:theme="@style/Theme.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-terminal-commands" />
            </intent-filter>
            <!--
                Chats and file managers often hand the file over as octet-stream, and a
                content:// path rarely carries the file name, so match that type too. The
                activity checks the content and rejects anything that is not a pack.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.tcmd" />
                <data android:pathPattern=".*\\..*\\.tcmd" />
                <data android:pathPattern=".*\\..*\\..*\\.tcmd" />
            </intent-filter>
        </activity>

        <activity
            android:name="app.lawnchair.BlankActivity"
            android:theme="@style/Theme.Transparent" />

        <activity
            android:name="app.lawnchair.smartspace.SmartspacePreferencesShortcut"
            android:theme="@style/Theme.Transparent" />

        <activity
            android:name="app.lawnchair.widgets.lottie.LottieWidgetConfigActivity"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Transparent" />

        <activity
            android:name="app.lawnchair.widgets.lottie.ImportWidgetActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/lottie_widget_import_title"
            android:theme="@style/Theme.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-terminal-widget" />
            </intent-filter>
            <!-- Files sent as octet-stream reach ImportCommandsActivity, which hands widgets over here. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.twgt" />
                <data android:pathPattern=".*\\..*\\.twgt" />
                <data android:pathPattern=".*\\..*\\..*\\.twgt" />
            </intent-filter>
        </activity>

        <activity
            android:name="app.lawnchair.command.ImportThemeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/theme_import_title"
            android:theme="@style/Theme.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-terminal-theme" />
            </intent-filter>
            <!-- Files sent as octet-stream reach ImportCommandsActivity, which hands themes over here. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.tthm" />
                <data android:pathPattern=".*\\..*\\.tthm" />
                <data android:pathPattern=".*\\..*\\..*\\.tthm" />
            </intent-filter>
        </activity>

        <receiver
            android:name="app.lawnchair.widgets.lottie.LottieWidgetPinReceiver"
            android:exported="false" />

        <receiver
            android:name="app.lawnchair.widgets.lottie.LottieAppWidgetProvider"
            android:exported="false"
            android:label="@string/lottie_widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lottie_appwidget_info" />
        </receiver>

        <receiver
            android:name="app.lawnchair.gestures.handlers.SleepMethodDeviceAdmin$SleepDeviceAdmin"
            android:description="@string/dt2s_admin_hint"
            android:exported="true"
            android:label="@string/derived_app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/sleep_policy" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="app.lawnchair.bugreport.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

        <provider
            android:name="app.lawnchair.search.LawnchairRecentSuggestionProvider"
            android:authorities="${applicationId}.search.LawnchairRecentSuggestionProvider"
            android:syncable="true"
            android:exported="false" />

        <receiver
            android:name="app.lawnchair.bugreport.BugReportReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="${applicationId}.bugreport.COPY" />
                <action android:name="${applicationId}.bugreport.UPLOAD" />
                <action android:name="${applicationId}.bugreport.UPLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="app.lawnchair.smartspace.SmartspaceAppWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/smartspace_appwidget_info" />
        </receiver>

        <meta-data
            android:name="xyz.paphonb.quickstepswitcher.minSdk"
            android:value="${quickstepMinSdk}" />

        <meta-data
            android:name="xyz.paphonb.quickstepswitcher.maxSdk"
            android:value="${quickstepMaxSdk}" />

        <provider
            android:name="org.chickenhook.restrictionbypass.BypassProvider"
            android:authorities="${applicationId}.restrictionbypass"
            tools:node="remove"/>

        <!-- App Functions (Android 16+): the launcher as a set of tools for assistants -->
        <service
            android:name="app.lawnchair.appfunctions.LauncherAppFunctionService"
            android:exported="true"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE"
            tools:targetApi="36">
            <property
                android:name="android.app.appfunctions.schema"
                android:value="app_functions_schema.xsd" />
            <property
                android:name="android.app.appfunctions.v2"
                android:value="launcher_app_function_service.xml" />
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
            </intent-filter>
        </service>
        <property
            android:name="android.app.appfunctions.app_metadata"
            android:resource="@xml/app_function_metadata" />
    </application>
</manifest>
